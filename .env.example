# ========================================================
# IT Support & Resource Management System
# Production Environment Variables (.env.example)
# ========================================================

# --- Next.js Application URL ---
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# --- Supabase Database & Auth (Free Tier) ---
# ดูค่าได้จาก Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# --- LINE Messaging API (LINE Notify / Flex Bot Free Tier) ---
# ดูค่าได้จาก LINE Developers Console -> Messaging API Channel
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_ADMIN_GROUP_ID=C1234567890abcdef1234567890abcdef

# --- Primary IT Administrator Account (Production) ---
# บัญชีสำหรับเจ้าหน้าที่ไอทีเข้าสู่ระบบจัดการ Master Data, Assets, และ Reports
NEXT_PUBLIC_ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=YourStrongAdminPassword2026!
